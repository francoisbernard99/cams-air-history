# Collected data: it regenerates, it does not belong in git.
data/*
!data/.gitkeep

# The warehouse is derived: rebuilt from the CSV files in seconds, never
# committed. A binary blob in git history is a blob you can never remove.
*.duckdb
*.duckdb.wal

# Worktree holding the `data` branch, created with:
#   git worktree add archive data
archive/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage

# This project uses no API key. The line below is hygiene, not a need: if a
# keyed source is ever added, the secret will not reach the repository by
# accident.
.env

# Editors
.vscode/
.idea/
*~
\#*\#
.\#*
